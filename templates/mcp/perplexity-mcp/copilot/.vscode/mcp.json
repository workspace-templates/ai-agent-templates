{
  "inputs": [
    {
      "type": "promptString",
      "id": "perplexity_api_key",
      "description": "Your Perplexity API key, from your Perplexity API account",
      "password": true
    }
  ],
  "servers": {
    "perplexity": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@perplexity-ai/mcp-server"
      ],
      "env": {
        "PERPLEXITY_API_KEY": "${input:perplexity_api_key}"
      }
    }
  }
}

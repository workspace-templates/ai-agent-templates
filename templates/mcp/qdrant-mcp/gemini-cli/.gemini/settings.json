{
  "mcpServers": {
    "qdrant": {
      "command": "uvx",
      "args": [
        "mcp-server-qdrant"
      ],
      "env": {
        "QDRANT_URL": "$QDRANT_URL",
        "QDRANT_API_KEY": "$QDRANT_API_KEY",
        "COLLECTION_NAME": "$COLLECTION_NAME",
        "QDRANT_READ_ONLY": "$QDRANT_READ_ONLY"
      }
    }
  }
}

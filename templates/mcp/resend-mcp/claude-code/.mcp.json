{
  "mcpServers": {
    "resend": {
      "command": "npx",
      "args": [
        "-y",
        "resend-mcp"
      ],
      "env": {
        "RESEND_API_KEY": "${RESEND_API_KEY}",
        "SENDER_EMAIL_ADDRESS": "${SENDER_EMAIL_ADDRESS}",
        "MCP_ALLOWED_FILE_DIRS": "${MCP_ALLOWED_FILE_DIRS}"
      }
    }
  }
}

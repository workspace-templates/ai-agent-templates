{
  "inputs": [
    {
      "type": "promptString",
      "id": "supabase_access_token",
      "description": "A Supabase personal access token",
      "password": true
    }
  ],
  "servers": {
    "supabase": {
      "type": "http",
      "url": "https://mcp.supabase.com/mcp?project_ref=${SUPABASE_PROJECT_REF}&read_only=true",
      "headers": {
        "Authorization": "Bearer ${input:supabase_access_token}"
      }
    }
  }
}

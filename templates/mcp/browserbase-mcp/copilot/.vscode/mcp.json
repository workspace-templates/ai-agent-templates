{
  "inputs": [
    {
      "type": "promptString",
      "id": "browserbase_api_key",
      "description": "Your Browserbase API key",
      "password": true
    },
    {
      "type": "promptString",
      "id": "browserbase_project_id",
      "description": "The Browserbase project the sessions run in",
      "password": true
    },
    {
      "type": "promptString",
      "id": "gemini_api_key",
      "description": "Key for the default Stagehand model, google/gemini-2.5-flash-lite",
      "password": true
    }
  ],
  "servers": {
    "browserbase": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "@browserbasehq/mcp"
      ],
      "env": {
        "BROWSERBASE_API_KEY": "${input:browserbase_api_key}",
        "BROWSERBASE_PROJECT_ID": "${input:browserbase_project_id}",
        "GEMINI_API_KEY": "${input:gemini_api_key}"
      }
    }
  }
}

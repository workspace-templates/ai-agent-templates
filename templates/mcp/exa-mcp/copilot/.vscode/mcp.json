{
  "inputs": [
    {
      "type": "promptString",
      "id": "exa_api_key",
      "description": "Your Exa API key",
      "password": true
    }
  ],
  "servers": {
    "exa": {
      "type": "http",
      "url": "https://mcp.exa.ai/mcp",
      "headers": {
        "x-api-key": "${input:exa_api_key}"
      }
    }
  }
}

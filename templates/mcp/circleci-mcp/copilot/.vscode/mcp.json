{
  "inputs": [
    {
      "type": "promptString",
      "id": "circleci_token",
      "description": "A CircleCI personal API token",
      "password": true
    }
  ],
  "servers": {
    "circleci": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@circleci/mcp-server-circleci@latest"
      ],
      "env": {
        "CIRCLECI_TOKEN": "${input:circleci_token}"
      }
    }
  }
}

{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"let d='';process.stdin.on('data',c=>d+=c).on('end',()=>{let j={};try{j=JSON.parse(d)}catch(e){}const fs=require('fs'),p=require('path'),o=require('os');try{const f=p.join(o.homedir(),'.claude','session-log.txt');fs.mkdirSync(p.dirname(f),{recursive:true});fs.appendFileSync(f,new Date().toISOString()+'  '+(j.cwd||process.cwd())+'  '+(j.session_id||'no-session-id')+String.fromCharCode(10))}catch(e){}process.exit(0)})\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
